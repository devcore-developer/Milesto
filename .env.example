# ── My List — environment configuration ─────────────────────────────────
# Copy to .env and adjust for your environment.

# SQLite (local development / self-hosted):
DATABASE_URL="file:./db/custom.db"
# PostgreSQL (Neon production — see DEPLOYMENT.md):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX.neon.tech/mylist?sslmode=require"

# Session signing secret (min 32 chars). Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string-32-chars-min"
# ── AI provider (optional — free-first) ──────────────────────
# All AI features are OPTIONAL: the app is fully usable with none of
# these set, and nothing ever spends money automatically. Requests run
# server-side only and go to exactly ONE OpenAI-compatible endpoint.
#
#   AI_PROVIDER         display label only (groq / openrouter / z.ai / openai / …)
#   AI_API_KEY          secret key from your provider dashboard
#   AI_BASE_URL         OpenAI-compatible root, e.g. https://api.groq.com/openai/v1
#   AI_MODEL            chat model id from your provider
#   AI_TRANSCRIBE_MODEL optional — enables voice → text (e.g. a Whisper model id)
#   AI_VISION           "0" disables image-input capability (default enabled)
#   AI_TIMEOUT_MS       per-request timeout (default 60000)
#   AI_DAILY_LIMIT      max AI calls per user per day (default 200)
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# AI_TRANSCRIBE_MODEL=
# AI_VISION=1
# AI_TIMEOUT_MS=60000
# AI_DAILY_LIMIT=200