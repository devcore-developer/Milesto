# ── My List — environment configuration ─────────────────────────────────
# Copy to .env and adjust for your environment.

# SQLite (local development / self-hosted):
DATABASE_URL="file:./db/custom.db"
# PostgreSQL (Neon production — see DEPLOYMENT.md):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX.neon.tech/mylist?sslmode=require"

# Session signing secret (min 32 chars). Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string-32-chars-min"