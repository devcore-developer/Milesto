// My List — Prisma schema (PostgreSQL / Neon)
//
// Production twin of prisma/schema.prisma (SQLite). The 13 models below are
// identical apart from the datasource provider, so the same application
// code runs unchanged against either database.
//
// Usage (see DEPLOYMENT.md §3):
//   DATABASE_URL="postgresql://…neon.tech/neondb?sslmode=require" \
//     npx prisma db push --schema prisma/schema.postgres.prisma
//   npx prisma generate --schema prisma/schema.postgres.prisma
//
// Note: SQLite does not support Prisma enums, and this schema keeps the
// same design on PostgreSQL (status/priority are String columns validated
// at the application layer via zod + TS unions) so both schemas stay
// perfectly portable and interchangeable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Auth ─────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categories      Category[]
  tasks           Task[]
  projects        Project[]
  clients          Client[]
  invoices         Invoice[]
  notifications    Notification[]
  documents        DocumentRecord[]
  reminderSetting  ReminderSetting?
  businessSettings BusinessSettings?
}

// ───────────────────────── Tasks ─────────────────────────

model Category {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#1E3A8A")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  notes       String?
  // TODO | IN_PROGRESS | COMPLETED
  status      String    @default("TODO")
  // LOW | MEDIUM | HIGH | URGENT
  priority    String    @default("MEDIUM")
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  order       Int       @default(0)
  // Milestones are zero-duration markers (Phase A4) — the timeline and
  // calendar treat them as diamonds, reminders keep treating them as tasks.
  isMilestone Boolean   @default(false)

  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  subtasks      Subtask[]
  notifications Notification[]
  // Phase A4 dependencies: this task is blocked by / blocks.
  blockingDependencies TaskDependency[] @relation("Blocking")
  dependingOn          TaskDependency[] @relation("DependsOn")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, projectId])
}

model Subtask {
  id        String   @id @default(cuid())
  title     String
  completed Boolean  @default(false)
  order     Int      @default(0)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

// ───────────────────────── Projects ─────────────────────────

model Project {
  id           String    @id @default(cuid())
  name         String
  description  String?
  // PLANNING | ACTIVE | ON_HOLD | COMPLETED | CANCELLED
  status       String    @default("PLANNING")
  // LOW | MEDIUM | HIGH | URGENT
  priority     String    @default("MEDIUM")
  startDate    DateTime?
  deadline     DateTime?
  deliveryDate DateTime?
  color        String?
  notes        String?

  // ── Financials (Phase 4) ──
  // Total value = agreedPrice + additionalCharges - discount (clamped ≥ 0)
  agreedPrice       Float   @default(0)
  additionalCharges Float   @default(0)
  additionalNotes   String?
  discount          Float   @default(0)

  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  tasks    Task[]
  invoices Invoice[]
  documents DocumentRecord[]
  brief    ProjectBrief?
  aiPlanDrafts AIPlanDraft[]
  aiConversations AIConversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

// ───────────────────────── Clients ─────────────────────────

model Client {
  id      String  @id @default(cuid())
  name    String
  company String?
  email   String?
  phone   String?
  address String?
  notes   String?
  // ACTIVE | INACTIVE
  status  String  @default("ACTIVE")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projects  Project[]
  invoices  Invoice[]
  documents DocumentRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ───────────────────────── Invoices ─────────────────────────

model Invoice {
  id        String   @id @default(cuid())
  number    String   @unique
  // DRAFT | SENT | PAID | PARTIALLY_PAID | OVERDUE | CANCELLED
  status    String   @default("DRAFT")
  issueDate DateTime @default(now())
  dueDate   DateTime?

  subtotal       Float  @default(0)
  // PERCENTAGE | FIXED
  discountType   String @default("PERCENTAGE")
  discountValue  Float  @default(0)
  discountAmount Float  @default(0)
  // Delivery / extra fees on top of the line items (Phase 5)
  additionalCharges Float @default(0)
  additionalNotes  String?
  // total = subtotal − discountAmount + additionalCharges (≥ 0)
  total          Float  @default(0)
  amountPaid     Float  @default(0)
  currency       String @default("EGP")

  notes String?
  terms String?

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  items    InvoiceItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  description String
  quantity    Float   @default(1)
  unitPrice   Float   @default(0)
  amount      Float   @default(0)
  order       Int     @default(0)
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ───────────────── Payments (Phase 4) ─────────────────

// Recorded payments against an invoice. `Invoice.amountPaid` is always
// kept in sync with the sum of these rows — payments are the single
// source of truth for how much of an invoice has been collected.
model Payment {
  id        String   @id @default(cuid())
  amount    Float
  paidAt    DateTime @default(now())
  // CASH | BANK_TRANSFER | CARD | OTHER
  method    String?
  notes     String?

  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

// ───────────────────── Notifications & Documents ─────────────────────

model Notification {
  id      String  @id @default(cuid())
  // DEADLINE_APPROACHING | OVERDUE | SYSTEM
  type    String
  title   String
  message String
  read    Boolean @default(false)
  taskId  String?
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, read])
}

// ───────────── Documents (Phase 6) ─────────────

// Saved documents: Scope of Work, Work Completion Report, Project Progress
// Report and Custom Project Reports. The full section content is stored as
// a JSON string (DocumentContent — see lib/documents.ts) so documents can
// be re-opened, re-edited and re-exported at any time.
model DocumentRecord {
  id     String @id @default(cuid())
  // SCOPE_OF_WORK | COMPLETION_REPORT | PROGRESS_REPORT | CUSTOM_REPORT
  type   String
  // Auto-generated DOC-YYYY-#### (unique across the app)
  number String @unique
  title  String
  // Output language of the document itself: "en" | "ar"
  language String @default("en")
  issueDate DateTime @default(now())
  // JSON-serialized DocumentContent { sections: [...] }
  content String @default("{\"sections\":[]}")

  // ── AI versioning (Phase A5) ──
  // 1 for manual documents; AI-generated SoWs/reports increment per project.
  versionNo Int @default(1)
  // Chain to the superseded version (null for the first version).
  previousVersionId String?
  // JSON traceability map { [sectionId]: sourceQuotes[] } — null for manual
  // documents, letting the review UI show which brief lines fed each section.
  aiTrace String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId String?
  client   Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, type])
  @@index([clientId])
  @@index([projectId])
}

// ───────────── Business / invoice settings (Phase 5) ─────────────

// Singleton row per user — branding & defaults used on invoices and PDF
// exports (business info, logo, currency, footer, payment instructions).
model BusinessSettings {
  id                  String   @id @default(cuid())
  businessName        String   @default("My List")
  businessEmail       String?
  businessPhone       String?
  businessAddress     String?
  // Free-text tax identification shown on invoices (optional)
  taxInfo             String?
  // ISO currency code applied to new invoices (EGP, USD, …)
  currency            String   @default("EGP")
  invoiceFooter       String?
  paymentInstructions String?
  // Logo stored as a data URL (data:image/…;base64,…) — kept small (≤ 400 KB)
  logoData            String?
  logoName            String?

  // ── Scheduling engine (Phase A4) ──
  // JSON weekday array, 0=Sunday. Weekends are DERIVED as the complement
  // (single source of truth — storing both could contradict).
  workingDays         String   @default("[0,1,2,3,4]")
  workingHoursPerDay  Float    @default(8)
  // JSON array of "YYYY-MM-DD" (fixed) and "MM-DD" (recurring yearly).
  holidays            String   @default("[]")
  defaultTaskDurationDays Float @default(1)
  autoScheduleNewTasks Boolean @default(true)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ───────────────────── Reminder settings (Phase 3) ─────────────────────

// One row per user — the notification bell & dashboard read these values.
model ReminderSetting {
  id                String  @id @default(cuid())
  // Master switch for deadline reminders
  enabled           Boolean @default(true)
  // Remind when a task is due within N days (0 = same day only)
  taskDaysBefore    Int     @default(3)
  // Remind when a project deadline/delivery is within N days
  projectDaysBefore Int     @default(7)
  // Also list overdue items
  includeOverdue    Boolean @default(true)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ───────────── Project Brief (Phase A2) ─────────────

// One brief per project. The brief is the source-of-truth artifact the AI
// analysis (Phase A3) and the SoW generator (Phase A5) read from.
model ProjectBrief {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions  BriefVersion[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Every save creates a new immutable version — nothing is ever overwritten,
// so earlier wording can always be recovered. `content` is the working text
// exactly as typed (never AI-rewritten); `transcript` keeps the raw ASR
// output untouched beside the edited text.
model BriefVersion {
  id        String       @id @default(cuid())
  briefId   String
  brief     ProjectBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  versionNo Int
  // Original description exactly as typed — NEVER AI-rewritten
  content   String       @default("")
  // Raw ASR transcript kept untouched beside the editable working text
  transcript String?
  // "en" | "ar" | "mixed" — dominant input language
  language  String       @default("en")
  // JSON array: ["text","voice","files"]
  sourceTypes String     @default("[]")
  attachments BriefAttachment[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([briefId, versionNo])
  @@index([briefId])
}

// Files attached to a brief version. The file itself lives in the DB as a
// data URL (logoData pattern — no filesystem, Vercel-safe) with a text
// extraction / vision summary stored beside it for the AI pipeline.
model BriefAttachment {
  id            String       @id @default(cuid())
  versionId     String
  version       BriefVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  name          String
  mime          String
  size          Int
  // Original file preserved as data URL (size-capped, logoData pattern)
  dataUrl       String?
  // Text extracted server-side (txt/md/pdf/docx) — linked to THIS attachment
  extractedText String?
  // Vision-capable provider output for images (null when provider lacks vision)
  visionSummary String?
  // READY | EXTRACTED | ANALYZED | UNSUPPORTED | FAILED
  processingStatus String    @default("READY")
  createdAt     DateTime     @default(now())

  @@index([versionId])
}

// ───────────── AI plan draft (Phase A3) ─────────────

// A staged AI analysis of the brief, kept as an immutable snapshot the user
// reviews before anything becomes a real task. Regeneration creates a NEW
// draft; approval is a one-way transition (DRAFT → APPROVED) and only
// converts the items the user accepted into rows.
model AIPlanDraft {
  id             String  @id @default(cuid())
  projectId      String
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  briefVersionId String?
  // DRAFT | APPROVED | DISCARDED
  status         String  @default("DRAFT")
  // Output language selected independently of the brief's input language
  language       String  @default("en")
  // Audit: which provider/model produced this draft
  provider       String?
  model          String?
  // JSON-serialized AIPlan — every item carries classification
  // (EXPLICIT | INFERRED | SUGGESTION) + sourceQuotes[] (brief substrings).
  // String + zod pattern (DocumentRecord.content) — portable to Postgres.
  payload        String  @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId, status])
}

// ───────────── Task dependencies (Phase A4) ─────────────

// finish-to-start links: `taskId` cannot start before `dependsOnId` ends.
// Cycles are rejected server-side (topological check) before any save.
model TaskDependency {
  id          String @id @default(cuid())
  taskId      String // blocked task
  dependsOnId String // must finish first
  task        Task   @relation("Blocking",  fields: [taskId],      references: [id], onDelete: Cascade)
  dependsOn   Task   @relation("DependsOn", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@index([taskId])
  @@index([dependsOnId])
}

// ───────────── Assistant memory (Phase A6) ─────────────

// Project-linked chat threads — PostgreSQL-persisted so conversations
// survive across devices. The BRIEF itself is never truncated; only the
// AI request context is windowed (last 10 messages + facts digest).
model AIConversation {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  // "en" | "ar"
  language  String   @default("en")
  messages  AIMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // USER | ASSISTANT
  role           String
  content        String
  createdAt      DateTime       @default(now())

  @@index([conversationId])
}